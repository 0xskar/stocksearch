# Ollama (local LLM backend) - https://ollama.com
# Requires `ollama serve` running (or the desktop app) and the model pulled:
#   ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=10m

# Finnhub (free tier) - https://finnhub.io/dashboard
# Optional: without it, the sentiment agent skips company-news lookups
# and relies on DuckDuckGo web search instead.
FINNHUB_API_KEY=

# Reddit "script" app - https://www.reddit.com/prefs/apps
# Optional: without these, the sentiment agent skips Reddit lookups
# and relies on DuckDuckGo web search instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stocksearch/0.1 by u/<your-reddit-username>

# Optional overrides
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
STOCKSEARCH_DB_PATH=./data/stocksearch.db
TICKER_PAUSE_SECONDS=2

# Logging - LOG_LEVEL=DEBUG also logs full tool-call args/results (verbose)
LOG_LEVEL=INFO
STOCKSEARCH_LOG_PATH=./logs/stocksearch.log
